ABDB_BIND=127.0.0.1
ABDB_PORT=8099
ABDB_IP=
ABDB_DOMAIN=
COOKIE_SECURE=0

# Optional localhost-only phpMyAdmin profile
ABDB_ADVANCED_PORT=8100
ABDB_ADVANCED_UPLOAD_LIMIT=64M

# Optional known source IP for the database allowlist (display only)
ABDB_DB_SOURCE_IP=

# Trusted SSH server fingerprints as a JSON object keyed by host:port
ABDB_SSH_HOST_KEYS='{}'
